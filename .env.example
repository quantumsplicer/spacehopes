# Copy to .env and edit. Never commit .env.
COMPOSE_PROFILES=dev            # dev = also start MinIO + Mailpit. Leave empty in production.
ENV=dev                         # dev | prod  (prod: OpenAPI docs off, Secure cookies, strict hosts)
DOMAIN=example.com              # production only (Caddy)
PUBLIC_URL=http://localhost:8080

POSTGRES_USER=thoughts
POSTGRES_PASSWORD=thoughts
POSTGRES_DB=thoughts

SECRET_KEY=change-me            # signs reader cookies; 48+ random chars
IP_SALT=change-me               # salt for hashed IP + user-agent; changing it resets blocks
BACKUP_PASSPHRASE=change-me     # encrypts nightly backups

OWNER_EMAIL=owner@example.com   # the Studio owner (created by `make seed`); sign-in alerts go here

# Storage: a local S3 server locally, Cloudflare R2 in production
S3_ENDPOINT=http://s3:8000
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey
S3_BUCKET=thoughts
S3_REGION=us-east-1

# Mail: Mailpit locally. In production set RESEND_API_KEY (or SMTP_* as the fallback)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Thoughts <hello@localhost>
RESEND_API_KEY=

# Cloudflare Turnstile. Cloudflare's public always-pass TEST keys (invisible widget). In production create an Invisible widget in the dashboard.
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Reader sign-in with Google (optional; the one-time email code always works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_DEV_TOOLS=1         # 1 shows the drawing FPS overlay (dev only)
RATE_LIMIT_ENABLED=true
