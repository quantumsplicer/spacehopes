# Production settings. `scripts/gen-env.sh your-domain.com you@private-address.com` copies this to .env and fills in
# the random secrets for you; you then add the R2, Resend and Turnstile values. NEVER commit .env.

COMPOSE_PROFILES=
ENV=prod
DOMAIN=your-domain.com
PUBLIC_URL=https://your-domain.com
NEXT_PUBLIC_DEV_TOOLS=0
RATE_LIMIT_ENABLED=true

POSTGRES_USER=thoughts
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=thoughts

SECRET_KEY=__GENERATE__
IP_SALT=__GENERATE__
# Encrypts backups. Keep a copy somewhere safe and offline: without it a backup cannot be restored.
BACKUP_PASSPHRASE=__GENERATE__

# Sign-in alerts and contact-form messages go here. Use an address that is not on the site.
OWNER_EMAIL=you@private-address.com

# ---- Media: Cloudflare R2 (bucket `spacehopes-media`, API token with Object Read & Write on that bucket) ----
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=spacehopes-media
S3_REGION=auto

# ---- Backups: a SECOND bucket, ideally on a different Cloudflare account, with its own token ----
S3_BACKUP_BUCKET=spacehopes-backups
S3_BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BACKUP_ACCESS_KEY=
S3_BACKUP_SECRET_KEY=

# ---- Email. Pick one: Resend (HTTPS API, needs a verified domain), the Gmail Apps Script relay (HTTPS, see docs/mail-relay.gs),
#      or plain SMTP (NOT possible on Render's free plan, which blocks SMTP ports). ----
APPS_SCRIPT_MAIL_URL=
APPS_SCRIPT_MAIL_SECRET=
RESEND_API_KEY=
MAIL_FROM=Space hopes <hello@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ---- Cloudflare Turnstile: create an INVISIBLE widget for your domain ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- Reader sign-in with Google (optional; the emailed one-time code always works) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
