# Production. Needs DOMAIN in .env. Caddy gets and renews the HTTPS certificate by itself.
#
# Real visitor addresses (for rate limits and comment blocking): when a request really comes from Cloudflare's network
# we believe the CF-Connecting-IP header; from anywhere else we ignore every forwarded header and use the connecting
# address, so nobody can fake their IP. Refresh these ranges from https://www.cloudflare.com/ips/ now and then.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	# The API docs are for development only
	@apidocs path /api/docs* /api/openapi.json /api/redoc*
	respond @apidocs 404

	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			# uploads: allow up to ~40 MB bodies, but give up on very slow clients
			transport http {
				response_header_timeout 60s
			}
		}
	}
	request_body /api/* {
		max_size 40MB
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 40
			roll_keep_for 4400h
		}
		format json
	}
}
